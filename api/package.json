{
  "name": "sabor-pedidos-api",
  "version": "1.0.0",
  "description": "API REST de SaborPedidos (Caso 03 - Grupo 1). Node.js + Express + MongoDB Atlas (Mongoose).",
  "main": "src/server.js",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "demo": "cross-env DB_MODE=memory node src/server.js",
    "seed": "node src/seed/seed.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js", "!src/seed/seed.js", "!src/config/db.js", "!src/models/**", "!src/repositories/*.mongo.js"]
  }
}
